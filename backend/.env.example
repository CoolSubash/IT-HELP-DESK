# Copy this file to `.env` and adjust if needed. Never commit the real `.env`.

# libpq connection URI, passed straight to psycopg2.connect(). Matches the
# credentials in infra/docker-compose.yml.
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk

ENVIRONMENT=development

# Comma-separated dashboard origins CORSMiddleware allows (app/main.py).
# infra/cdk/stacks/compute_stack.py overrides this to the deployed
# frontend's ALB DNS name (or custom domain) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Email (Phase 4) ---
# "dev" logs emails instead of sending them -- no AWS credentials needed
# for local development. Switch to "ses" to actually deliver email.
EMAIL_PROVIDER=dev
IT_SUPPORT_EMAIL=it-support@university.edu
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave true for local dev -- POST /email/inbound accepts requests with no
# credential check. Set to false (and set EMAIL_WEBHOOK_SECRET) anywhere
# real inbound email will actually reach this endpoint.
EMAIL_WEBHOOK_DEV_MODE=true
EMAIL_WEBHOOK_SECRET=

# --- RAG / knowledge base (Phase 7) ---
# "dev" generates local deterministic embeddings -- no AWS credentials
# needed. Switch to "bedrock" to call Amazon Titan Text Embeddings.
# See docs/rag-manual for the full design writeup and testing walkthrough.
EMBEDDING_PROVIDER=dev
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE_WORDS=600
RAG_CHUNK_OVERLAP_WORDS=80
RAG_DEFAULT_TOP_K=5

# "s3" (the default) uploads knowledge-base files to
# KNOWLEDGE_STORAGE_S3_BUCKET via a presigned URL the browser PUTs
# directly to (POST /admin/knowledge/presign) or, for non-browser
# callers, via the server itself (POST /admin/knowledge). Requires
# KNOWLEDGE_STORAGE_S3_BUCKET to be set to a real bucket, and AWS
# credentials with s3:PutObject/s3:GetObject on it -- uploads fail with
# a clear error until both are set. "local" (writes to disk under
# KNOWLEDGE_STORAGE_LOCAL_DIR, no AWS needed) still exists purely as
# the test suite's backend (tests/conftest.py forces it on) -- it is
# NOT used by the app itself with this default.
KNOWLEDGE_STORAGE_BACKEND=s3
KNOWLEDGE_STORAGE_LOCAL_DIR=storage/knowledge_documents
KNOWLEDGE_STORAGE_S3_BUCKET=
